import sys
import os
import platform
import subprocess
import shutil

print("=" * 80)
print("SYSTEM")
print("=" * 80)
print(f"OS               : {platform.platform()}")
print(f"Machine          : {platform.machine()}")
print(f"Processor        : {platform.processor()}")
print(f"Python Version   : {sys.version}")
print(f"Python Executable: {sys.executable}")
print(f"Conda Prefix     : {os.environ.get('CONDA_PREFIX', 'Not using conda')}")

print("\n" + "=" * 80)
print("JUPYTER")
print("=" * 80)

try:
    from IPython import get_ipython
    print("IPython Version  :", __import__("IPython").__version__)
    print("Kernel           :", get_ipython())
except Exception as e:
    print("Could not determine Jupyter info:", e)

print("\n" + "=" * 80)
print("PYTORCH")
print("=" * 80)

try:
    import torch

    print("Torch Version          :", torch.__version__)
    print("Torch CUDA Version     :", torch.version.cuda)
    print("CUDA Available         :", torch.cuda.is_available())
    print("CUDA Device Count      :", torch.cuda.device_count())

    if torch.cuda.is_available():
        for i in range(torch.cuda.device_count()):
            print(f"\nGPU {i}")
            print("Name                  :", torch.cuda.get_device_name(i))
            print("Capability            :", torch.cuda.get_device_capability(i))
            print("Memory (GB)           :",
                  round(torch.cuda.get_device_properties(i).total_memory / 1024**3, 2))
except Exception as e:
    print("PyTorch Error:", e)

print("\n" + "=" * 80)
print("NVIDIA-SMI")
print("=" * 80)

try:
    result = subprocess.run(
        ["nvidia-smi"],
        capture_output=True,
        text=True
    )

    if result.returncode == 0:
        print(result.stdout)
    else:
        print(result.stderr)
except FileNotFoundError:
    print("nvidia-smi not found in PATH.")

print("\n" + "=" * 80)
print("CUDA TOOLKIT")
print("=" * 80)

try:
    result = subprocess.run(
        ["nvcc", "--version"],
        capture_output=True,
        text=True
    )

    if result.returncode == 0:
        print(result.stdout)
    else:
        print("nvcc not found.")
except FileNotFoundError:
    print("nvcc not installed or not in PATH.")

print("\n" + "=" * 80)
print("PIP PACKAGES")
print("=" * 80)

packages = [
    "torch",
    "torchvision",
    "torchaudio",
    "numpy",
    "jupyter",
    "ipykernel"
]

try:
    result = subprocess.run(
        [sys.executable, "-m", "pip", "show"] + packages,
        capture_output=True,
        text=True
    )

    print(result.stdout if result.stdout else "No package info.")
except Exception as e:
    print(e)

print("\n" + "=" * 80)
print("ENVIRONMENT VARIABLES")
print("=" * 80)

for var in [
    "CUDA_PATH",
    "CUDA_HOME",
    "CUDA_VISIBLE_DEVICES",
    "PATH"
]:
    print(f"\n{var}:")
    value = os.environ.get(var)

    if value is None:
        print("Not set")
    elif var == "PATH":
        for p in value.split(os.pathsep):
            if "NVIDIA" in p.upper() or "CUDA" in p.upper():
                print(" ", p)
    else:
        print(value)

print("\n" + "=" * 80)
print("DONE")
print("=" * 80)



