import os
import sys
import platform
import subprocess
import shutil
import importlib.util

print("=" * 80)
print("SYSTEM")
print("=" * 80)
print(f"OS              : {platform.platform()}")
print(f"Machine         : {platform.machine()}")
print(f"Processor       : {platform.processor()}")
print(f"Python          : {sys.version}")
print(f"Executable      : {sys.executable}")
print(f"Prefix          : {sys.prefix}")
print(f"Base Prefix     : {sys.base_prefix}")

print("\n" + "=" * 80)
print("JUPYTER")
print("=" * 80)

try:
    from ipykernel import __version__ as ipykernel_version
    print("ipykernel       :", ipykernel_version)
except Exception as e:
    print("ipykernel       : Not found", e)

print("\nCurrent Working Directory:")
print(os.getcwd())

print("\n" + "=" * 80)
print("CONDA")
print("=" * 80)

conda = shutil.which("conda")

if conda:
    print("Conda executable:", conda)

    try:
        print("\nConda Info")
        print(subprocess.check_output(
            ["conda", "info"],
            text=True,
            stderr=subprocess.STDOUT
        ))
    except Exception as e:
        print(e)

    try:
        print("\nConda Environments")
        print(subprocess.check_output(
            ["conda", "env", "list"],
            text=True,
            stderr=subprocess.STDOUT
        ))
    except Exception as e:
        print(e)
else:
    print("Conda not found in PATH.")

print("\n" + "=" * 80)
print("PYTORCH")
print("=" * 80)

if importlib.util.find_spec("torch"):

    import torch

    print("Torch Version           :", torch.__version__)
    print("CUDA Available          :", torch.cuda.is_available())
    print("Compiled CUDA Version   :", torch.version.cuda)
    print("CUDA Device Count       :", torch.cuda.device_count())

    if torch.cuda.is_available():
        for i in range(torch.cuda.device_count()):
            print(f"\nGPU {i}")
            print("Name :", torch.cuda.get_device_name(i))
            print("Capability :", torch.cuda.get_device_capability(i))
            print("Properties :", torch.cuda.get_device_properties(i))
else:
    print("PyTorch not installed")

print("\n" + "=" * 80)
print("NVIDIA")
print("=" * 80)

nvidia_smi = shutil.which("nvidia-smi")

if nvidia_smi:
    try:
        print(subprocess.check_output(
            [nvidia_smi],
            text=True,
            stderr=subprocess.STDOUT
        ))
    except Exception as e:
        print(e)
else:
    print("nvidia-smi not found")

print("\n" + "=" * 80)
print("PIP")
print("=" * 80)

try:
    print(subprocess.check_output(
        [sys.executable, "-m", "pip", "--version"],
        text=True
    ))
except Exception as e:
    print(e)

try:
    print(subprocess.check_output(
        [sys.executable, "-m", "pip", "list"],
        text=True
    ))
except Exception as e:
    print(e)

print("\n" + "=" * 80)
print("JUPYTER KERNELS")
print("=" * 80)

try:
    print(subprocess.check_output(
        ["jupyter", "kernelspec", "list"],
        text=True
    ))
except Exception as e:
    print(e)

print("\n" + "=" * 80)
print("DONE")
print("=" * 80)




